              ],
              "path": [
                "predictions",
                "batch"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batch_name\": \"Postman portfolio test\",\n  \"customers\": [\n    {\n      \"customer_ref\": \"POSTMAN-1\",\n      \"LIMIT_BAL\": 50000,\n      \"SEX\": 2,\n      \"EDUCATION\": 2,\n      \"MARRIAGE\": 1,\n      \"AGE\": 37,\n      \"PAY_0\": 2,\n      \"PAY_2\": 2,\n      \"PAY_3\": 2,\n      \"PAY_4\": 0,\n      \"PAY_5\": 0,\n      \"PAY_6\": 0,\n      \"BILL_AMT1\": 46990,\n      \"BILL_AMT2\": 48233,\n      \"BILL_AMT3\": 49291,\n      \"BILL_AMT4\": 28314,\n      \"BILL_AMT5\": 28959,\n      \"BILL_AMT6\": 29547,\n      \"PAY_AMT1\": 0,\n      \"PAY_AMT2\": 0,\n      \"PAY_AMT3\": 1000,\n      \"PAY_AMT4\": 1100,\n      \"PAY_AMT5\": 1069,\n      \"PAY_AMT6\": 1000\n    },\n    {\n      \"customer_ref\": \"POSTMAN-2\",\n      \"LIMIT_BAL\": 500000,\n      \"SEX\": 2,\n      \"EDUCATION\": 1,\n      \"MARRIAGE\": 1,\n      \"AGE\": null,\n      \"PAY_0\": -1,\n      \"PAY_2\": -1,\n      \"PAY_3\": -1,\n      \"PAY_4\": -1,\n      \"PAY_5\": -1,\n      \"PAY_6\": -1,\n      \"BILL_AMT1\": 12000,\n      \"BILL_AMT2\": 9000,\n      \"BILL_AMT3\": 15000,\n      \"BILL_AMT4\": 8000,\n      \"BILL_AMT5\": 11000,\n      \"BILL_AMT6\": 7000,\n      \"PAY_AMT2\": 15000,\n      \"PAY_AMT3\": 8000,\n      \"PAY_AMT4\": 11000,\n      \"PAY_AMT5\": 7000,\n      \"PAY_AMT6\": 10000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dbOn = pm.collectionVariables.get(\"dbMode\") === \"enabled\";",
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"2 customers, 1 predicted default\", () => { pm.expect(b.total_customers).to.eql(2); pm.expect(b.predicted_defaults).to.eql(1); });",
                  "pm.test(\"1 customer with imputed values\", () => pm.expect(b.customers_with_imputed_values).to.eql(1));",
                  "pm.test(\"risk bands sum to total\", () => pm.expect(b.risk_band_breakdown.reduce((s, x) => s + x.customers, 0)).to.eql(2));",
                  "pm.test(\"stored only when the database is enabled\", () => {",
                  "    pm.expect(b.stored).to.eql(dbOn);",
                  "    if (dbOn) pm.collectionVariables.set(\"batchId\", b.batch_id); else pm.expect(b.batch_id).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
