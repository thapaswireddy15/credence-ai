          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created (missing value accepted)\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"BILL_AMT3 reported as imputed\", () => pm.expect(b.imputed_features).to.eql([\"BILL_AMT3\"]));",
                  "pm.test(\"valid probability\", () => pm.expect(b.default_probability).to.be.within(0, 1));",
                  "if (b.prediction_id) pm.collectionVariables.set(\"imputedPredictionId\", b.prediction_id);"
                ]
              }
            }
          ]
