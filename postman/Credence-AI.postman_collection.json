{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-00000000002a",
    "name": "Credence AI API",
    "description": "Automated tests for the Credence AI credit default prediction API. Works against a MySQL-backed server (database_mode=enabled) and the predict-only public deployment (database_mode=disabled): GET /health records the mode and later tests adapt. Run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Service",
      "item": [
        {
          "name": "GET / - service info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"stakeholder is Credit Portfolio Strategist\", () => pm.expect(b.stakeholder).to.eql(\"Credit Portfolio Strategist\"));",
                  "pm.test(\"database_mode reported\", () => pm.expect([\"enabled\", \"disabled\"]).to.include(b.database_mode));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"dbMode\", b.database_mode);",
                  "pm.test(\"status ok\", () => pm.expect(b.status).to.eql(\"ok\"));",
                  "pm.test(\"model loaded\", () => pm.expect(b.model_loaded).to.be.true);",
                  "pm.test(\"missing-value imputation available\", () => pm.expect(b.missing_value_imputation).to.be.true);",
                  "pm.test(\"database connected when enabled / null when disabled\", () => {",
                  "    if (b.database_mode === \"enabled\") pm.expect(b.database_connected).to.be.true;",
                  "    else pm.expect(b.database_connected).to.be.null;",
                  "});",
                  "pm.test(\"response time < 2s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /model/info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/model/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "model",
                "info"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"target is default.payment.next.month\", () => pm.expect(b.target).to.eql(\"default.payment.next.month\"));",
                  "pm.test(\"23 features\", () => pm.expect(b.features).to.have.lengthOf(23));",
                  "pm.test(\"threshold in (0,1)\", () => { pm.expect(b.decision_threshold).to.be.above(0); pm.expect(b.decision_threshold).to.be.below(1); });",
                  "pm.test(\"CV and test metrics present\", () => { pm.expect(b.cv_metrics).to.have.property(\"f1\"); pm.expect(b.test_metrics_tuned_threshold).to.have.property(\"roc_auc\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Prediction - complete record",
      "item": [
        {
          "name": "POST /predictions - complete record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predictions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_ref\": \"POSTMAN-1\",\n  \"LIMIT_BAL\": 50000,\n  \"SEX\": 2,\n  \"EDUCATION\": 2,\n  \"MARRIAGE\": 1,\n  \"AGE\": 37,\n  \"PAY_0\": 2,\n  \"PAY_2\": 2,\n  \"PAY_3\": 2,\n  \"PAY_4\": 0,\n  \"PAY_5\": 0,\n  \"PAY_6\": 0,\n  \"BILL_AMT1\": 46990,\n  \"BILL_AMT2\": 48233,\n  \"BILL_AMT3\": 49291,\n  \"BILL_AMT4\": 28314,\n  \"BILL_AMT5\": 28959,\n  \"BILL_AMT6\": 29547,\n  \"PAY_AMT1\": 0,\n  \"PAY_AMT2\": 0,\n  \"PAY_AMT3\": 1000,\n  \"PAY_AMT4\": 1100,\n  \"PAY_AMT5\": 1069,\n  \"PAY_AMT6\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dbOn = pm.collectionVariables.get(\"dbMode\") === \"enabled\";",
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"probability in [0,1]\", () => { pm.expect(b.default_probability).to.be.within(0, 1); });",
                  "pm.test(\"high-risk example predicted as Default\", () => { pm.expect(b.predicted_default).to.be.true; pm.expect(b.prediction_label).to.eql(\"Default\"); });",
                  "pm.test(\"risk band valid\", () => pm.expect([\"LOW\", \"MEDIUM\", \"HIGH\"]).to.include(b.risk_band));",
                  "pm.test(\"nothing imputed for a complete record\", () => pm.expect(b.imputed_features).to.eql([]));",
                  "pm.test(\"stored only when the database is enabled\", () => {",
                  "    pm.expect(b.stored).to.eql(dbOn);",
                  "    if (dbOn) { pm.expect(b.prediction_id).to.be.a(\"number\"); pm.collectionVariables.set(\"predictionId\", b.prediction_id); }",
                  "    else pm.expect(b.prediction_id).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
