# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored -- never commit real credentials.

APP_ENV=development

# Set to false for predict-only mode (no MySQL needed; nothing is stored,
# history/portfolio endpoints return 503). This is how the public deployment runs.
DATABASE_ENABLED=true

# --- Local MySQL (used when DATABASE_URL is not set) -------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=credence_ai

# --- OR a single URL (e.g. on Render with a hosted MySQL) --------------------
# Special characters in the password must be URL-encoded here (@ -> %40).
# DATABASE_URL=mysql+pymysql://user:password@host:3306/credence_ai?charset=utf8mb4

# --- Tests use a separate database (default: <MYSQL_DATABASE>_test) ----------
# TEST_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/credence_ai_test

# --- Optional ----------------------------------------------------------------
# MODEL_PATH=models/credence_model.joblib
# MAX_BATCH_SIZE=1000
