# Copy this file to .env to override defaults:  cp .env.example .env
# .env is git-ignored. Credence AI uses NO database, so no credentials are needed.

APP_ENV=development

# Maximum predictions kept in the temporary in-memory history (oldest evicted first).
# The history is cleared whenever the server restarts.
MAX_STORED_PREDICTIONS=10000

# Maximum customers per POST /predictions/batch request.
MAX_BATCH_SIZE=1000

# Optional: path to the trained model artifact.
# MODEL_PATH=models/credence_model.joblib
